# Copy this file to .env and fill in real values. Never commit .env itself.

# Connection string from your Postgres provider (Supabase/Neon/Render).
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Any long random string — used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The exact URL your frontend is served from (GitHub Pages URL), used for CORS.
# Example: https://yourusername.github.io
FRONTEND_ORIGIN=http://localhost:5500

# The public URL of the frontend app itself — used to build links inside emails
# (e.g. the "Review in Copperbelt ILC" button). Usually the same as FRONTEND_ORIGIN.
APP_URL=http://localhost:5500

# SMTP server for outgoing email (activation links, password resets, feedback-released
# notifications, deletion requests). Works with any standard SMTP provider — your hosting
# provider's mail server, Gmail/Office365, or an SMTP relay from Mailgun/SendGrid/etc.
# If SMTP_HOST/SMTP_USER/SMTP_PASS are left blank, emails are skipped (logged to the
# console instead) rather than failing requests — useful for local development.
SMTP_HOST=
SMTP_PORT=587
# Leave blank to auto-detect (true only for port 465); set explicitly to override.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# The From header shown on outgoing mail, e.g. Copperbelt ILC <no-reply@yourdomain.org>
SMTP_FROM_EMAIL=

PORT=4000
